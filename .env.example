# Copy to .env and fill in, or export these in your shell.
# .env is gitignored: the service-role key must never be committed.

# "local" (default) or "supabase".
PPTX_STORAGE_BACKEND=local

# --- local backend --------------------------------------------------------
# Where the Template Bank lives. Defaults to ./template_bank
# PPTX_BANK_ROOT=./template_bank

# --- supabase backend -----------------------------------------------------
# From Project Settings -> API in the Supabase dashboard.
# SUPABASE_URL=https://your-project.supabase.co

# The service-role key. It bypasses row-level security by design, which is
# why the server uses it and why it must stay server-side - never ship it to
# a browser or commit it.
# SUPABASE_SERVICE_KEY=

# Where Supabase objects are cached as local files. Masters and logos have to
# exist on disk for python-pptx to open them. Defaults to a temp directory.
# PPTX_CACHE_DIR=
